<Window x:Class="ImageOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Overlay" Height="80" Width="150" Icon="images.ico"
        Topmost="True" Background="#80000000" AllowsTransparency="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- The overlay image with panning and zooming -->
        <Grid x:Name="ViewportGrid" ClipToBounds="True" Background="Transparent"
              MouseWheel="ViewportGrid_MouseWheel" 
              MouseRightButtonDown="ViewportGrid_MouseRightButtonDown" 
              MouseRightButtonUp="ViewportGrid_MouseRightButtonUp" 
              MouseMove="ViewportGrid_MouseMove"
              MouseLeftButtonDown="ViewportGrid_MouseLeftButtonDown" 
              MouseLeftButtonUp="ViewportGrid_MouseLeftButtonUp">
            
            <Canvas x:Name="ImageCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Image x:Name="OverlayImage" Stretch="None" />
            </Canvas>
        </Grid>
        
        <!-- Initial Controls (when no image loaded) -->
        <StackPanel x:Name="InitialControlsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Click="LoadImage_Click" Margin="5" Width="40" Height="40" Background="Transparent" BorderThickness="0" ToolTip="Load Image">
                <Image Source="load.png" Stretch="Uniform"/>
            </Button>
            <Button Content="x" Click="Close_Click" Margin="5" Width="40" Height="40" Background="#AA0000" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="20" ToolTip="Close"/>
        </StackPanel>
        
        <!-- Controls that are active when image is loaded, but hide when locked -->
        <Grid x:Name="ControlsPanel" Visibility="Hidden">
            <!-- Close button: Top Right -->
            <Button Content="x" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="5" Width="24" Height="24" Background="#AA0000" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" ToolTip="Close"/>
            
            <!-- Load button: Bottom Left -->
            <Button Click="LoadImage_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                    Margin="5" Width="32" Height="32" Background="Transparent" BorderThickness="0" ToolTip="Load Image">
                <Image Source="load.png" Stretch="Uniform"/>
            </Button>
            
            <!-- Settings Panel (Bottom Center) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="5">
                <Border x:Name="SettingsPanel" Background="#CC000000" CornerRadius="5" Visibility="Collapsed" Padding="10">
                    <StackPanel Width="150">
                        <TextBlock Text="Opacity" Foreground="White" FontSize="10"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="OpacitySlider_ValueChanged" Margin="0,0,0,5"/>
                        
                        <TextBlock Text="Contrast" Foreground="White" FontSize="10"/>
                        <Slider x:Name="ContrastSlider" Minimum="0.0" Maximum="3.0" Value="1.0" ValueChanged="FilterSlider_ValueChanged" Margin="0,0,0,5"/>
                        
                        <TextBlock Text="Tolerance" Foreground="White" FontSize="10"/>
                        <Slider x:Name="ToleranceSlider" Minimum="0.0" Maximum="1.0" Value="0.1" ValueChanged="FilterSlider_ValueChanged" Margin="0,0,0,5"/>

                        <Button x:Name="EyedropperBtn" Content="Pick Color" Click="EyedropperBtn_Click" Margin="0,5,0,0" Height="22" FontSize="10"/>
                        <Button x:Name="ClearColorBtn" Content="Clear Mask" Click="ClearColorBtn_Click" Margin="0,5,0,0" Height="22" FontSize="10"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ToggleSettingsBtn" Click="ToggleSettingsBtn_Click" Width="30" Height="15" Background="#B2000000" Foreground="White" BorderThickness="0" ToolTip="Settings">
                    <TextBlock x:Name="ToggleSettingsText" Text="^" FontSize="10" FontWeight="Bold" Margin="0,-2,0,0"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Pin Button: Top Left, Always Visible (when image loaded) -->
        <Button x:Name="PinButton" Visibility="Hidden" Click="Lock_Click" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="5" Width="16" Height="16" Background="Transparent" BorderThickness="0" ToolTip="Toggle Lock">
            <Ellipse Fill="#FF3333" Width="12" Height="12"/>
        </Button>

        <!-- Resize Thumb: Bottom Right -->
        <Thumb x:Name="ResizeThumb" Visibility="Hidden" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Path Fill="White" Data="M 0,15 L 15,15 L 15,0 Z" Opacity="0.5"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
