<Window x:Class="ImageOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Overlay" Height="400" Width="600" Icon="images.ico"
        Topmost="True" Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Image x:Name="OverlayImage" Stretch="Uniform"/>
        
        <StackPanel x:Name="ControlsPanel" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#B2000000" Margin="10" Opacity="0.8">
            <Button Content="Load Image" Click="LoadImage_Click" Margin="10,10,5,10" Padding="10,5" Background="#333333" Foreground="White" BorderThickness="0"/>
            <Button Content="Lock (Click-Through)" Click="Lock_Click" Margin="5,10,5,10" Padding="10,5" Background="#333333" Foreground="White" BorderThickness="0" ToolTip="Makes the app click-through. Unlock from System Tray!"/>
            
            <TextBlock Text="Opacity:" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" Width="100" Margin="5,0,10,0" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
            
            <Button Content="Close" Click="Close_Click" Margin="5,10,10,10" Padding="10,5" Background="#AA0000" Foreground="White" BorderThickness="0"/>
        </StackPanel>
        
        <Thumb x:Name="ResizeThumb" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Path Fill="White" Data="M 0,15 L 15,15 L 15,0 Z" Opacity="0.5"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
